<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
<stop offset="100%" style="stop-color:#4682B4;stop-opacity:1" />
</linearGradient>
<linearGradient id="buildingGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#F5DEB3;stop-opacity:1" />
<stop offset="100%" style="stop-color:#D2B48C;stop-opacity:1" />
</linearGradient>
<linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#00CED1;stop-opacity:1" />
<stop offset="100%" style="stop-color:#008B8B;stop-opacity:1" />
</linearGradient>
</defs>

<!-- Sky Background -->
<rect width="400" height="200" fill="url(#skyGrad)"/>

<!-- Water -->
<rect y="200" width="400" height="100" fill="url(#waterGrad)"/>

<!-- Atlantis The Royal Main Building -->
<rect x="150" y="75" width="100" height="125" fill="url(#buildingGrad)" rx="5"/>

<!-- Central Tower -->
<rect x="175" y="50" width="50" height="75" fill="url(#buildingGrad)" rx="4"/>

<!-- Side Wings -->
<rect x="75" y="100" width="60" height="100" fill="url(#buildingGrad)" rx="4"/>
<rect x="265" y="100" width="60" height="100" fill="url(#buildingGrad)" rx="4"/>

<!-- Windows -->
<rect x="80" y="110" width="4" height="6" fill="#4682B4" opacity="0.8"/>
<rect x="90" y="110" width="4" height="6" fill="#4682B4" opacity="0.8"/>
<rect x="100" y="110" width="4" height="6" fill="#4682B4" opacity="0.8"/>
<rect x="110" y="110" width="4" height="6" fill="#4682B4" opacity="0.8"/>
<rect x="120" y="110" width="4" height="6" fill="#4682B4" opacity="0.8"/>

<rect x="155" y="85" width="6" height="8" fill="#4682B4" opacity="0.8"/>
<rect x="165" y="85" width="6" height="8" fill="#4682B4" opacity="0.8"/>
<rect x="175" y="85" width="6" height="8" fill="#4682B4" opacity="0.8"/>
<rect x="185" y="85" width="6" height="8" fill="#4682B4" opacity="0.8"/>
<rect x="195" y="85" width="6" height="8" fill="#4682B4" opacity="0.8"/>

<!-- Luxury Text -->
<text x="200" y="275" text-anchor="middle" font-family="serif" font-size="16" font-weight="bold" fill="#FFD700">ATLANTIS ROYAL</text>
</svg>