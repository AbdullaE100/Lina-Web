<svg width="800" height="600" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="skyGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#87CEEB;stop-opacity:1" />
<stop offset="100%" style="stop-color:#4682B4;stop-opacity:1" />
</linearGradient>
<linearGradient id="buildingGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#F5DEB3;stop-opacity:1" />
<stop offset="100%" style="stop-color:#D2B48C;stop-opacity:1" />
</linearGradient>
<linearGradient id="waterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
<stop offset="0%" style="stop-color:#00CED1;stop-opacity:1" />
<stop offset="100%" style="stop-color:#008B8B;stop-opacity:1" />
</linearGradient>
</defs>

<!-- Sky Background -->
<rect width="800" height="400" fill="url(#skyGrad)"/>

<!-- Water -->
<rect y="400" width="800" height="200" fill="url(#waterGrad)"/>

<!-- Atlantis The Royal Main Building -->
<rect x="300" y="150" width="200" height="250" fill="url(#buildingGrad)" rx="10"/>

<!-- Central Tower -->
<rect x="350" y="100" width="100" height="150" fill="url(#buildingGrad)" rx="8"/>

<!-- Side Wings -->
<rect x="150" y="200" width="120" height="200" fill="url(#buildingGrad)" rx="8"/>
<rect x="530" y="200" width="120" height="200" fill="url(#buildingGrad)" rx="8"/>

<!-- Windows -->
<rect x="160" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="175" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="190" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="205" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="220" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="235" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="250" y="220" width="8" height="12" fill="#4682B4" opacity="0.8"/>

<!-- More Window Rows -->
<rect x="160" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="175" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="190" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="205" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="220" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="235" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>
<rect x="250" y="250" width="8" height="12" fill="#4682B4" opacity="0.8"/>

<!-- Central Building Windows -->
<rect x="310" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="330" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="350" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="370" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="390" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="410" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="430" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="450" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>
<rect x="470" y="170" width="12" height="16" fill="#4682B4" opacity="0.8"/>

<!-- Palm Trees -->
<ellipse cx="100" cy="350" rx="30" ry="50" fill="#228B22"/>
<rect x="95" y="350" width="10" height="50" fill="#8B4513"/>

<ellipse cx="700" cy="350" rx="30" ry="50" fill="#228B22"/>
<rect x="695" y="350" width="10" height="50" fill="#8B4513"/>

<!-- Luxury Text -->
<text x="400" y="550" text-anchor="middle" font-family="serif" font-size="32" font-weight="bold" fill="#FFD700">ATLANTIS THE ROYAL</text>
<text x="400" y="580" text-anchor="middle" font-family="serif" font-size="18" fill="#FFFFFF">Ultra-Luxury Beachfront Residences</text>
</svg>